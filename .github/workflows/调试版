name: FreeMCHost Auto Renew

on:
  # schedule:
  #   - cron: '0 */2 * * *'  # 调试成功后，把这两行的注释符 # 删掉开启定时运行
  workflow_dispatch:

jobs:
  renew:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          pip install seleniumbase aiohttp PyNaCl
          seleniumbase install chromedriver
          sudo apt-get update
          sudo apt-get install -y xvfb xdotool scrot

      - name: Run
        env:
          # 确保这里的变量名和你 GitHub Secrets 里的一致
          ACCOUNTS: ${{ secrets.FREEMCHOST_ACCOUNTS }}
          TG_BOT_TOKEN: ${{ secrets.TG_BOT_TOKEN }}
          TG_CHAT_ID: ${{ secrets.TG_CHAT_ID }}
          REPO_TOKEN: ${{ secrets.REPO_TOKEN }}
          GITHUB_REPOSITORY: ${{ github.repository }}
          # 【核心修改】强制 SeleniumBase 的浏览器启动分辨率，解决黑屏截断问题
          GS_START_WINDOW_SIZE: "1920,1080"
        run: |
          xvfb-run --auto-servernum --server-args="-screen 0 1920x1080x24" python scripts/freemchost_renew.py

      - name: Upload screenshots
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: screenshots
          path: "*.png"
          retention-days: 1
